# Velos dashboard environment
# Base URL of the RideWay backend API (no trailing slash).
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Optional shared secret for the dashboard endpoints. When the backend sets
# DASHBOARD_API_KEY, the dashboard must send the matching value here as the
# `x-dashboard-key` header. Leave empty for local development (backend then
# serves dashboard endpoints unauthenticated).
VITE_DASHBOARD_API_KEY=
